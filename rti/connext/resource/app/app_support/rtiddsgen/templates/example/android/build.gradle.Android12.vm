buildscript {
	repositories{
	    mavenCentral()
		google()
	}

    dependencies {
        #[[//]]#
        #[[//]]#   Gradle Plugin: 7.3.0
        #[[//]]#   Gradle version required: 7.0+
		classpath 'com.android.tools.build:gradle:7.3.0'
    }
}
apply plugin: 'android'

dependencies {
    implementation 'com.android.support:multidex:1.0.3'
    implementation fileTree(dir: 'src/main/jniLibs', include: ['*.jar'])
}

allprojects{
	repositories{
        mavenCentral()
        google()
    }
}
android {
/*
    The Connext libs are built and tested against a specific
    Android SDK using a specific version of the Android Build Tools.
    However, an end user should be able to use a different
    SDK version via the ANDROID_API environment variable and a different
    version of the build tools via the ANDROID_BUILD_TOOLS_VERSION
    environment variable.
*/
    if (System.getenv('ANDROID_API')) {
        compileSdkVersion 'android-'+System.getenv('ANDROID_API')
    } else {    
        compileSdkVersion 'android-31'
    }
    if (System.getenv('ANDROID_BUILD_TOOLS_VERSION')) {
        buildToolsVersion System.getenv('ANDROID_BUILD_TOOLS_VERSION')
    } else {    
        buildToolsVersion '32.0.0'
    }

    buildTypes {
        release {
            minifyEnabled false
        }
    }
    lintOptions {
          abortOnError false
    }
    defaultConfig {
        multiDexEnabled true
        if (System.getenv('ANDROID_API')) {
            minSdkVersion System.getenv('ANDROID_API')
            targetSdkVersion System.getenv('ANDROID_API')
        } else {        
            minSdkVersion 31
            targetSdkVersion 31
        }
    }
    compileOptions {
        sourceCompatibility JavaVersion.VERSION_11
        targetCompatibility JavaVersion.VERSION_11
    }
    // When building the debug version of the app, the AGP uses a new 
    // packaging tool called zipflinger. Due to several bugs, we need to
    // we include these rules to avoid issues for testing purposes
    packagingOptions {
		exclude 'resources.arsc'
        exclude 'AndroidManifest.xml'
    }
}

